            "dark": "{color.status.error-light}"
          }
        }
      },
      "tone-unknown": {
        "$type": "color",
        "$value": "{color.status.unknown-dark}",
        "$description": "« unknown » state on the current background: dot, alert stripe",
        "$extensions": {
          "fr.ekonum": {
            "dark": "{color.status.unknown}"
          }
        }
      },
      "tile": {
        "$type": "color",
        "$value": "{color.palette.dark-green}",
        "$description": "icon tile: dark plaque on light, light plaque on dark — as the guidelines ask",
        "$extensions": {
          "fr.ekonum": {
            "dark": "{color.palette.off-white}"
          }
        }
      },
      "on-tile": {
        "$type": "color",
        "$value": "{color.palette.turquoise}",
        "$description": "pictogram on the icon tile",
        "$extensions": {
          "fr.ekonum": {
            "dark": "{color.palette.dark-green}"
          }
        }
      },
      "halo": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0078, 0.102, 0.102],
          "hex": "#021A1A",
          "alpha": 0
        },
        "$description": "hairline that detaches a thin mark from the bright colour it crosses (the audio playhead over the kept part): none on light, dark green on dark",
        "$extensions": {
          "fr.ekonum": {
            "dark": "{color.palette.dark-green}"
          }
        }
      }
    }
  },
  "typography": {
    "font": {
      "$description": "Typography: Chillax (headings) and Synonym (body), as in the guidelines.",
      "font-heading": {
        "$type": "fontFamily",
        "$value": ["Chillax", "system-ui", "sans-serif"],
        "$description": "headings, buttons, labels of states and badges"
      },
      "font-body": {
        "$type": "fontFamily",
        "$value": ["Synonym", "system-ui", "sans-serif"],
        "$description": "running text, fields, tables"
      }
    },
    "size": {
      "$description": "Sizes. DELIBERATE DEPARTURE: the guidelines give a 1.6 ratio between paragraph, subtitle and title. That is a poster scale — applied to a 16 px body it only yields three steps (16 / 26 / 41) and skips the sizes a dense interface needs. We keep the font, the hierarchy and the tracking; we tighten the scale. The three large headings are fluid: a 44 px hero title takes three lines on a phone. `$value` gives the desktop size, `$extensions` the formula and the minimum size. The rem part preserves the user's text zoom.",
      "text-xs": {
        "$type": "dimension",
        "$value": {
          "value": 0.75,
          "unit": "rem"
        },
        "$description": "12 — meta, labels"
      },
      "text-sm": {
        "$type": "dimension",
        "$value": {
          "value": 0.875,
          "unit": "rem"
        },
        "$description": "14 — secondary text"
      },
      "text-md": {
        "$type": "dimension",
        "$value": {
          "value": 1,
          "unit": "rem"
        },
        "$description": "16 — body"
      },
      "text-lg": {
        "$type": "dimension",
        "$value": {
          "value": 1.25,
          "unit": "rem"
        },
        "$description": "20 — card title"
      },
      "text-xl": {
        "$type": "dimension",
        "$value": {
          "value": 1.625,
          "unit": "rem"
        },
        "$description": "26 — section title (≈16×1.6); fluid from 375 to 1080 px wide, 22 → 26 px",
        "$extensions": {
          "fr.ekonum": {
            "css": "clamp(1.375rem, 1.24rem + .57vw, 1.625rem)",
            "min": {
              "value": 1.375,
              "unit": "rem"
            }
          }
        }
      },
      "text-2xl": {
        "$type": "dimension",
        "$value": {
          "value": 2.125,
          "unit": "rem"
        },
        "$description": "34 — page title; fluid from 375 to 1080 px wide, 28 → 34 px",
        "$extensions": {
          "fr.ekonum": {
            "css": "clamp(1.75rem, 1.55rem + .85vw, 2.125rem)",
            "min": {
              "value": 1.75,
              "unit": "rem"
            }
          }
        }
      },
      "text-3xl": {
        "$type": "dimension",
        "$value": {
          "value": 2.75,
          "unit": "rem"
        },
        "$description": "44 — hero title; fluid from 375 to 1080 px wide, 32 → 44 px",
        "$extensions": {
          "fr.ekonum": {
            "css": "clamp(2rem, 1.6rem + 1.7vw, 2.75rem)",
            "min": {
              "value": 2,
              "unit": "rem"
            }
          }
        }
      }
    },
    "rhythm": {
      "$description": "Tracking and line heights. The guidelines ask for -10 units of tracking on every text.",
      "tracking": {
        "$type": "number",
        "$value": -0.01,
        "$description": "em, i.e. the guidelines' -10 units",
        "$extensions": {
          "fr.ekonum": {
            "css": "-.01em"
          }
        }
      },
      "leading-heading": {
        "$type": "number",
        "$value": 1.15,
        "$description": "the guidelines use ≈1.12 on large headings"
      },
      "leading-body": {
        "$type": "number",
        "$value": 1.55,
        "$description": "> the guidelines' 1.36: reading on screen, not projection"
      }
    }
  },
  "space": {
    "$description": "Spacing: the vertical and horizontal rhythm.",
    "space-1": {
      "$type": "dimension",
      "$value": {
        "value": 0.25,
        "unit": "rem"
      },
      "$description": "4 px: inside dense controls"
    },
    "space-2": {
      "$type": "dimension",
      "$value": {
        "value": 0.5,
        "unit": "rem"
      },
      "$description": "8 px: gap between a label and its field, small clusters"
    },
    "space-3": {
      "$type": "dimension",
      "$value": {
        "value": 0.75,
        "unit": "rem"
      },
      "$description": "12 px: gap between buttons, field padding"
    },
    "space-4": {
      "$type": "dimension",
      "$value": {
        "value": 1,
        "unit": "rem"
      },
      "$description": "16 px: grid gap, card inner blocks"
    },
    "space-5": {
      "$type": "dimension",
      "$value": {
        "value": 1.5,
        "unit": "rem"
      },
      "$description": "24 px: card padding, button side padding"
    },
    "space-6": {
      "$type": "dimension",
      "$value": {
        "value": 2,
        "unit": "rem"
      },
      "$description": "32 px: dialog padding, large blocks"
    },
    "space-7": {
      "$type": "dimension",
      "$value": {
        "value": 3,
        "unit": "rem"
      },
      "$description": "48 px: between page sections"
    },
    "space-8": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "rem"
      },
      "$description": "64 px: page top, anchor margin"
    }
  },
  "layout": {
    "$description": "Layout, mobile first: components adapt to the room they have (intrinsic grids, wrapping) rather than to global breakpoints. A custom property cannot be used in a media query: the reference widths are the test's (375, 768, 1280 px).",
    "target": {
      "$type": "dimension",
      "$value": {
        "value": 2.75,
        "unit": "rem"
      },
      "$description": "44 px: minimum height of a button or a field"
    },
    "target-min": {
      "$type": "dimension",
      "$value": {
        "value": 1.5,
        "unit": "rem"
      },
      "$description": "24 px: WCAG 2.5.8 minimum for any active element"
    },
    "gutter": {
      "$type": "dimension",
      "$value": {
        "value": 2,
        "unit": "rem"
      },
      "$description": "page side margin, 16 → 32 px",
      "$extensions": {
        "fr.ekonum": {
          "css": "clamp(1rem, 4vw, 2rem)",
          "min": {
            "value": 1,
            "unit": "rem"
          }
        }
      }
    },
    "page-width": {
      "$type": "dimension",
      "$value": {
        "value": 70,
        "unit": "rem"
      },
      "$description": "1120 px: maximum content width"
    }
  },
  "radius": {
    "$description": "Radii. The guidelines give none, but their icon tiles and CTA are clearly rounded. We reuse that vocabulary — ~22 % for tiles, full pill for buttons.",
    "radius-tile": {
      "$type": "number",
      "$value": 0.22,
      "$description": "fraction of the tile's side; DTCG cannot express a percentage",
      "$extensions": {
        "fr.ekonum": {
          "css": "22%"
        }
      }
