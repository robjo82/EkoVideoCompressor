      },
      "hover-dark": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0431, 0.2353, 0.2039],
          "hex": "#0B3C34"
        },
        "$description": "hover of a dark-green button; hue of the brand's dark gradient"
      },
      "border-control": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0078, 0.102, 0.102],
          "hex": "#021A1A",
          "alpha": 0.5
        },
        "$description": "field border: ≥ 3:1 against the field and around it, in both themes",
        "$extensions": {
          "fr.ekonum": {
            "dark": {
              "colorSpace": "srgb",
              "components": [0.9176, 0.9176, 0.9176],
              "hex": "#EAEAEA",
              "alpha": 0.5
            }
          }
        }
      },
      "text": {
        "$type": "color",
        "$value": "{color.palette.dark-green}",
        "$description": "body text on background and surface",
        "$extensions": {
          "fr.ekonum": {
            "dark": "{color.palette.off-white}"
          }
        }
      },
      "text-muted": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0078, 0.102, 0.102],
          "hex": "#021A1A",
