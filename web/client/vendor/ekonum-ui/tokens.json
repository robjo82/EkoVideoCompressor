        },
        "$description": "label on the destructive button",
        "$extensions": {
          "fr.ekonum": {
            "dark": "{color.palette.dark-green}"
          }
        }
      },
      "tone-success": {
        "$type": "color",
        "$value": "{color.status.success-dark}",
        "$description": "« success » state on the current background: dot, alert stripe",
        "$extensions": {
          "fr.ekonum": {
            "dark": "{color.status.success}"
          }
        }
      },
      "tone-warning": {
        "$type": "color",
