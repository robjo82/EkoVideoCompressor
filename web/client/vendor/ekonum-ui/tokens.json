{
  "$description": "Ekonum tokens — the brand guidelines (Brand Guidelines, BolimDesign 2025) translated for application interfaces. src/tokens.json is the single token source; src/tokens.css is generated from it. Brand guidelines are written for posters, posts and slides. An interface departs from them on three points, documented here rather than endured: typographic density, semantic states, and the share of dark.",
  "color": {
    "palette": {
      "$description": "Official brand palette.",
      "dark-green": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0078, 0.102, 0.102],
          "hex": "#021A1A"
        },
        "$description": "brand ink: primary button on light, text, headers and dark areas"
      },
      "off-white": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9176, 0.9176, 0.9176],
          "hex": "#EAEAEA"
        },
        "$description": "brand light: page base, text and primary button label on dark green"
      },
      "turquoise": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1647, 0.8275, 0.6235],
          "hex": "#2AD39F"
        },
        "$description": "brand signal: primary button and current link on dark green, continuity; never under light text"
      },
      "violet": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.5882, 0.2706, 0.8392],
          "hex": "#9645D6"
        },
        "$description": "occasional accent: badge and hero button, with pure white text; one or two per screen"
      }
    },
    "ui": {
      "$description": "Interface shades, for surfaces and borders. The guidelines provide no grey scale; an interface needs one (separators, hovers, disabled fields). Derived from dark green by opacity, so never neutral grey — they keep the hue. Those that change in the dark theme carry their dark value in $extensions[\"fr.ekonum\"].dark: off-white by opacity over dark green, the mirror of the light shades.",
      "surface": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9569, 0.9569, 0.949],
          "hex": "#F4F4F2"
        },
        "$description": "card background, lighter than the base; dark: off-white at 8 % over dark green",
        "$extensions": {
          "fr.ekonum": {
            "dark": {
              "colorSpace": "srgb",
              "components": [0.0824, 0.1686, 0.1686],
              "hex": "#152B2B"
            }
          }
        }
      },
      "background": {
        "$type": "color",
        "$value": "{color.palette.off-white}",
        "$description": "page base; dark: off-white at 4 % over dark green, so the header and dark areas stay a shade deeper",
        "$extensions": {
          "fr.ekonum": {
            "dark": {
              "colorSpace": "srgb",
              "components": [0.0431, 0.1333, 0.1333],
              "hex": "#0B2222"
            }
          }
        }
      },
      "border": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0078, 0.102, 0.102],
          "hex": "#021A1A",
          "alpha": 0.12
        },
        "$description": "hairline separators, card borders, row hover",
        "$extensions": {
          "fr.ekonum": {
            "dark": {
              "colorSpace": "srgb",
              "components": [0.9176, 0.9176, 0.9176],
              "hex": "#EAEAEA",
              "alpha": 0.12
            }
          }
        }
      },
      "border-strong": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0078, 0.102, 0.102],
          "hex": "#021A1A",
          "alpha": 0.24
        },
        "$description": "subtle button outline, table header rule, choice card border",
        "$extensions": {
          "fr.ekonum": {
            "dark": {
              "colorSpace": "srgb",
              "components": [0.9176, 0.9176, 0.9176],
              "hex": "#EAEAEA",
              "alpha": 0.32
