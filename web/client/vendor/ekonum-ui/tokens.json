      },
      "error-dark": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.749, 0.2275, 0.1686],
          "hex": "#BF3A2B"
        },
        "$description": "text and dot on a light background; the note's #C03A2B rounded to 4.497:1"
      },
      "error-light": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.8706, 0.4667, 0.4196],
          "hex": "#DE776B"
        },
        "$description": "text on a dark surface (dark theme): the hue lightened until it reaches 4.5:1 in a card; #D6584A only reaches 3.8:1"
      },
      "unknown": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9176, 0.9176, 0.9176],
          "hex": "#EAEAEA",
          "alpha": 0.5
        },
        "$description": "dot on a dark background; dark green at 38 % until 1.2, invisible on dark"
      },
      "unknown-dark": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0078, 0.102, 0.102],
          "hex": "#021A1A",
          "alpha": 0.5
        },
        "$description": "dot on a light background"
      }
    },
    "role": {
      "$description": "Roles — what the components paint with. A component never names a palette colour for something that changes with the background: it asks for the action, the focus ring, the tone of a state. The dark theme redefines the roles (and the shades above); .ekn-dark, .ekn-selection-bar and [data-ekn-theme] apply it — a dark area and a dark page are the same mechanism.",
      "field": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [1.0, 1.0, 1.0],
          "hex": "#FFFFFF"
        },
        "$description": "inside of a field, track of a switch: white on light, dark green (a shade below the card) on dark",
        "$extensions": {
          "fr.ekonum": {
            "dark": "{color.palette.dark-green}"
          }
        }
      },
      "hover": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0078, 0.102, 0.102],
          "hex": "#021A1A",
          "alpha": 0.12
        },
        "$description": "background of a hovered row, menu item, subtle button or day",
        "$extensions": {
          "fr.ekonum": {
            "dark": {
              "colorSpace": "srgb",
              "components": [0.9176, 0.9176, 0.9176],
              "hex": "#EAEAEA",
              "alpha": 0.08
            }
          }
        }
      },
      "action": {
        "$type": "color",
        "$value": "{color.palette.dark-green}",
        "$description": "primary button, checked control, selected day: the colour with the most contrast against its background",
        "$extensions": {
          "fr.ekonum": {
            "dark": "{color.palette.turquoise}"
          }
        }
      },
      "on-action": {
        "$type": "color",
        "$value": "{color.palette.off-white}",
        "$description": "label and pictogram on the action colour",
        "$extensions": {
          "fr.ekonum": {
            "dark": "{color.palette.dark-green}"
          }
        }
      },
      "action-hover": {
        "$type": "color",
        "$value": "{color.ui.hover-dark}",
        "$description": "hovered primary button; dark: turquoise at 94 % brightness",
        "$extensions": {
          "fr.ekonum": {
            "dark": {
              "colorSpace": "srgb",
              "components": [0.1529, 0.7765, 0.5843],
              "hex": "#27C695"
            }
          }
        }
      },
      "focus": {
        "$type": "color",
        "$value": "{color.palette.dark-green}",
        "$description": "focus ring: 2 px, ≥ 3:1 on every background of its theme",
        "$extensions": {
          "fr.ekonum": {
            "dark": "{color.palette.turquoise}"
          }
        }
      },
      "danger": {
