      },
      "hover-inverse": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9176, 0.9176, 0.9176],
          "hex": "#EAEAEA",
          "alpha": 0.08
        },
        "$description": "hover on a dark background"
      },
      "overlay": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0078, 0.102, 0.102],
          "hex": "#021A1A",
          "alpha": 0.48
        },
        "$description": "backdrop behind a modal dialog: the page stays visible, dimmed",
        "$extensions": {
          "fr.ekonum": {
            "dark": {
              "colorSpace": "srgb",
              "components": [0.0078, 0.102, 0.102],
              "hex": "#021A1A",
              "alpha": 0.72
            }
          }
        }
      },
      "highlight": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1647, 0.8275, 0.6235],
          "hex": "#2AD39F",
          "alpha": 0.24
        },
        "$description": "highlighted passage, selected row: turquoise, translucent, under dark text"
      }
    },
    "status": {
      "$description": "Semantic states — an extension of the guidelines, APPROVED by the brand on 24/09/2026. The guidelines have no warning or error colour; a monitoring tool needs them: \"compliant / to check / failing / unknown\" cannot be told with four shades of turquoise. Each state has two shades: the hue, for dots on dark backgrounds, and its dark shade, for text and dots on light backgrounds — on #EAEAEA the hues fell to 1.60–3.26:1, the dark shades reach 4.5:1. One single error red for the whole fleet.",
      "success": {
        "$type": "color",
        "$value": "{color.palette.turquoise}",
        "$description": "dot on a dark background"
      },
      "success-dark": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0941, 0.4706, 0.3529],
          "hex": "#18785A"
        },
