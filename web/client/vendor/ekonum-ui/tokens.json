          "colorSpace": "srgb",
          "components": [0.851, 0.6431, 0.2549],
          "hex": "#D9A441"
        },
        "$description": "dot on a dark background"
      },
      "warning-dark": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.5373, 0.3882, 0.1059],
          "hex": "#89631B"
        },
        "$description": "text and dot on a light background"
      },
      "error": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.8392, 0.3451, 0.2902],
